{
  "name": "sportslab-landing",
  "version": "1.0.0",
  "private": true,
  "description": "SportsLAB — Landing page de apuestas deportivas. React + Vite + SCSS (BEM).",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --port 5412",
    "start": "vite --port 5412",
    "build": "vite build",
    "preview": "vite preview --port 5412",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,scss,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,scss,css}\""
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "vite": "^7.0.0"
  }
}
