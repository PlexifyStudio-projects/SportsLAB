# -----------------------------------------------------------------------------
# Variables de entorno — SportsLAB (plantilla)
# Copia este archivo como `.env` y rellena los valores. NUNCA subas `.env` al repo.
# En Vite, toda variable expuesta al cliente DEBE llevar el prefijo VITE_.
# -----------------------------------------------------------------------------

# URL base de la API de cuotas/eventos
VITE_API_BASE_URL=https://api.sportslab.example

# Endpoint de registro / captación de leads
VITE_SIGNUP_URL=https://api.sportslab.example/signup

# Edad legal mínima para el mercado objetivo (juego responsable)
VITE_MIN_AGE=18
